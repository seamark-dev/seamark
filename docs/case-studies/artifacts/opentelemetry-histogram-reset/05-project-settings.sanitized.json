{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "<home>/.local/bin/seamark lessons --hook-reset",
            "statusMessage": "seamark: resetting lesson delivery",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "<home>/.local/bin/seamark gate --hook",
            "statusMessage": "seamark gate: classifying command",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "<home>/.local/bin/seamark lessons --hook",
            "statusMessage": "seamark: checking review lessons",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  }
}
