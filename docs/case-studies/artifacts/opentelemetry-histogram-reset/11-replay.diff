+func TestDeltaHistogramReuseDestinationWithNoSum(t *testing.T) {
+	orig := now
+	now = func() time.Time { return y2k }
+	t.Cleanup(func() { now = orig })
+
+	// First histogram: with sum recording enabled
+	h1 := newDeltaHistogram[int64](bounds, noMinMax, false, 0, dropExemplars[int64])
+	h1.measure(t.Context(), 2, alice, nil)
+
+	// Collect into destination
+	var dest metricdata.Aggregation = metricdata.Histogram[int64]{}
+	n := h1.collect(&dest)
+	require.Equal(t, 1, n)
+	histogram1 := dest.(metricdata.Histogram[int64])
+	require.Len(t, histogram1.DataPoints, 1)
+	require.Equal(t, int64(2), histogram1.DataPoints[0].Sum)
+	_, minValid := histogram1.DataPoints[0].Min.Value()
+	_, maxValid := histogram1.DataPoints[0].Max.Value()
+	require.True(t, minValid)
+	require.True(t, maxValid)
+
+	// Second histogram: with sum recording disabled, reusing the same destination
+	h2 := newDeltaHistogram[int64](bounds, noMinMax, true, 0, dropExemplars[int64])
+	h2.measure(t.Context(), 3, alice, nil)
+
+	// Collect into the same destination
+	n = h2.collect(&dest)
+	require.Equal(t, 1, n)
+	histogram2 := dest.(metricdata.Histogram[int64])
+	require.Len(t, histogram2.DataPoints, 1)
+	// Sum should be zero (cleared) since noSum is true
+	require.Equal(t, int64(0), histogram2.DataPoints[0].Sum, "Sum should be cleared when noSum is true")
+	// Min and Max should still be valid since noMinMax is false
+	_, minValid = histogram2.DataPoints[0].Min.Value()
+	_, maxValid = histogram2.DataPoints[0].Max.Value()
+	require.True(t, minValid)
+	require.True(t, maxValid)
+}
+
+func TestDeltaHistogramReuseDestinationWithNoMinMax(t *testing.T) {
+	orig := now
+	now = func() time.Time { return y2k }
+	t.Cleanup(func() { now = orig })
+
+	// First histogram: with min/max recording enabled
+	h1 := newDeltaHistogram[int64](bounds, false, false, 0, dropExemplars[int64])
+	h1.measure(t.Context(), 2, alice, nil)
+
+	// Collect into destination
+	var dest metricdata.Aggregation = metricdata.Histogram[int64]{}
+	n := h1.collect(&dest)
+	require.Equal(t, 1, n)
+	histogram1 := dest.(metricdata.Histogram[int64])
+	require.Len(t, histogram1.DataPoints, 1)
+	require.Equal(t, int64(2), histogram1.DataPoints[0].Sum)
+	_, minValid := histogram1.DataPoints[0].Min.Value()
+	_, maxValid := histogram1.DataPoints[0].Max.Value()
+	require.True(t, minValid)
+	require.True(t, maxValid)
+
+	// Second histogram: with min/max recording disabled, reusing the same destination
+	h2 := newDeltaHistogram[int64](bounds, true, false, 0, dropExemplars[int64])
+	h2.measure(t.Context(), 3, alice, nil)
+
+	// Collect into the same destination
+	n = h2.collect(&dest)
+	require.Equal(t, 1, n)
+	histogram2 := dest.(metricdata.Histogram[int64])
+	require.Len(t, histogram2.DataPoints, 1)
+	// Sum should still have value since noSum is false
+	require.Equal(t, int64(3), histogram2.DataPoints[0].Sum)
+	// Min and Max should be cleared since noMinMax is true
+	_, minValid = histogram2.DataPoints[0].Min.Value()
+	_, maxValid = histogram2.DataPoints[0].Max.Value()
+	require.False(t, minValid, "Min should be cleared when noMinMax is true")
+	require.False(t, maxValid, "Max should be cleared when noMinMax is true")
+}
