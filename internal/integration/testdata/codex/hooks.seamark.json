{
  "description": "seamark lifecycle hooks; managed entries are recognized by their command marker",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/seamark gate --hook --client codex",
            "timeout": 15,
            "statusMessage": "seamark gate: classifying command"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/seamark lessons --hook --client codex",
            "timeout": 10,
            "statusMessage": "seamark: checking review lessons"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/seamark lessons --hook-reset --client codex",
            "timeout": 10,
            "statusMessage": "seamark: resetting lesson delivery"
          }
        ]
      }
    ]
  }
}
