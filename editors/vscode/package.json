{
  "name": "seamark",
  "displayName": "Seamark",
  "description": "History and effects layer for your repo: hover shows what really changes together and why; diagnostics catch co-change omissions.",
  "version": "0.0.1",
  "publisher": "seamark-dev",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Seamark",
      "properties": {
        "seamark.path": {
          "type": "string",
          "default": "seamark",
          "description": "Path to the seamark binary."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
